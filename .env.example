# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/renewflow?schema=public"

# App
NEXT_PUBLIC_APP_NAME="RenewFlow"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Stripe (platform account for Connect)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect OAuth (Dashboard → Connect → Settings → Integration)
STRIPE_CLIENT_ID="ca_..."
# Optional override; defaults to ${APP_URL}/api/stripe/connect/callback
# STRIPE_CONNECT_REDIRECT_URI="http://localhost:3000/api/stripe/connect/callback"

# Email (Resend). If unset, recovery emails log to the console.
RESEND_API_KEY="re_..."
EMAIL_FROM="RenewFlow <onboarding@resend.dev>"

# Protects /api/jobs/run in every environment.
# Send `Authorization: Bearer <CRON_SECRET>`. Query-string secrets are ignored.
CRON_SECRET="replace-me"
