# Names only. Leave values empty in git.
# npm run local:setup writes gitignored .env.local for 127.0.0.1:54329/renewflow_local
# and http://127.0.0.1:3010. It generates NEXTAUTH_SECRET, CRON_SECRET, and
# POSTGRES_PASSWORD without printing them.

DATABASE_URL=
APP_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=RenewFlow

# Optional until a Stripe test sandbox is approved. Test prefix only: sk_test_ or rk_test_.
# Webhook signing secret is the test endpoint secret. Do not put a connected account id here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=
# STRIPE_CONNECT_REDIRECT_URI=

# Do not set RESEND_API_KEY or EMAIL_FROM for local runs. Mail logs to the console.
# Live Stripe events are rejected by the application. There is no enablement variable.
