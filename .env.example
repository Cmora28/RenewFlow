# Copy to .env and replace every placeholder.
# Never commit .env or real keys. Stripe, Resend, and database values below are not secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/renewflow?schema=public"

# App
NEXT_PUBLIC_APP_NAME="RenewFlow"
APP_URL="http://localhost:3000"
# Optional alias used by payment-update links when APP_URL is unset
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Stripe platform account (Connect). Use test-mode keys locally.
# Leave these unset to run the UI against the demo seed with no Stripe calls.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect OAuth (Dashboard → Connect → Settings → Integration)
STRIPE_CLIENT_ID="ca_..."
# Optional override; defaults to ${APP_URL}/api/stripe/connect/callback
# STRIPE_CONNECT_REDIRECT_URI="http://localhost:3000/api/stripe/connect/callback"
# Optional; defaults to NEXTAUTH_SECRET for the OAuth state cookie
# STRIPE_CONNECT_STATE_SECRET="generate-another-long-random-string"

# Email (Resend). If unset, recovery emails log to the console (no network send).
RESEND_API_KEY="re_..."
EMAIL_FROM="RenewFlow <onboarding@resend.dev>"

# Protects /api/jobs/run (required in production)
CRON_SECRET="replace-me"
